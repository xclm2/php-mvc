    "dev": "npm run watch-css"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "sass": "^1.93.2"
  }
}
